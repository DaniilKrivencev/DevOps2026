# Шаблон конфигурации. Скопируйте в .env (setup.sh делает это сам).
APP_ENV=development

# Локально по умолчанию — SQLite-файл. Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://duma_user:duma_pass@localhost:5432/city_duma
DATABASE_URL=sqlite+aiosqlite:///./cityduma.db

# Отдельная тестовая БД (используется только при APP_ENV=test).
# Не задана — каждый тест получает свой временный SQLite-файл.
# TEST_DATABASE_URL=postgresql+asyncpg://duma_user:duma_pass@localhost:5432/city_duma_test
