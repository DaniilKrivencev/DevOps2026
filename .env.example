# Шаблон переменных окружения (ЛР1). Скопируйте в .env и задайте свои значения.
# Имена переменных совпадают с docker-compose.yml и app/database.py.
POSTGRES_USER=duma_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=city_duma
DATABASE_URL=postgresql+asyncpg://duma_user:change_me@localhost:5432/city_duma
SECRET_KEY=change_me_to_random_string
APP_ENV=development
DEBUG=true
