# Шаблон конфигурации. Скопируйте в .env (setup.sh делает это сам).
APP_ENV=development

# Локально по умолчанию — SQLite-файл. Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://duma_user:duma_pass@localhost:5432/city_duma
DATABASE_URL=sqlite+aiosqlite:///./cityduma.db

# Отдельная тестовая БД (используется только при APP_ENV=test).
# Не задана — каждый тест получает свой временный SQLite-файл.
# TEST_DATABASE_URL=postgresql+asyncpg://duma_user:duma_pass@localhost:5432/city_duma_test

# Авторизация HTTP Basic: "логин:пароль:роль" через запятую, роли admin | secretary.
# В production обязательна. Если не задана в development/test — демо-учётки
# admin:admin и secretary:secretary (только для локальной работы!).
# AUTH_USERS=admin:change_me:admin,secretary:change_me_too:secretary

# Уровень журналирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Контейнерное окружение (docker compose, ЛР4) ───────────────────────────────
# Пароли — только здесь, в .env (не коммитится). В образ они не попадают.
POSTGRES_USER=duma_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=city_duma
# Учётные записи приложения в контейнерах (передаются как AUTH_USERS)
APP_AUTH_USERS=admin:change_me:admin,secretary:change_me_too:secretary
# Порт nginx на хосте; тег образа задаёт make (версия-SHA), latest запрещён
HTTP_PORT=8080
# APP_TAG=0.4.0-local
# Имя volume с данными PostgreSQL (для восстановления в новый volume)
# PG_VOLUME=cityduma_pg_data
