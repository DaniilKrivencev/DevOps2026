# Конфигурация службы cityduma (ЛР2). Шаблон без реальных значений.
# На сервере: /etc/cityduma/cityduma.env, права 640, владелец root:duma-app.
# Файл создаёт deploy/deploy_app.sh из переменных окружения.
APP_ENV=production
APP_PORT=8000
LOG_LEVEL=INFO
# пользователь приложения с правами только на DML (см. deploy_db.sh)
DATABASE_URL=postgresql+asyncpg://duma_app:<DB_APP_PASS>@172.27.206.20:5432/city_duma
AUTH_USERS=admin:<пароль>:admin,secretary:<пароль>:secretary
