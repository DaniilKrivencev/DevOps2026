# Настройки тестового окружения (staging), ЛР6. Шаблон без реальных значений.
# На сервере: /opt/cityduma-staging/.env, владелец root:cd-deploy, права 640.
# Создаёт и меняет администратор; pipeline файл не изменяет. В образ не попадает.

# Образ в registry (без тега: тег передаёт pipeline — sha-<commit> или X.Y.Z)
APP_IMAGE=ghcr.io/daniilkrivencev/devops2026
HTTP_PORT=8080
PG_VOLUME=cityduma_staging_pg_data
LOG_LEVEL=INFO
LOG_FORMAT=json

POSTGRES_USER=duma_staging
POSTGRES_PASSWORD=change_me
POSTGRES_DB=city_duma_staging
APP_AUTH_USERS=admin:change_me:admin,secretary:change_me_too:secretary

# учётная запись для проверки основного сценария после развёртывания
SMOKE_USER=admin
SMOKE_PASSWORD=change_me

# 1 — при неуспешной проверке автоматически вернуть предыдущую версию
AUTO_ROLLBACK=1
