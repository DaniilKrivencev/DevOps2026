# {{ ansible_managed }}
# Настройки окружения {{ env_name }}: отдельно от образа, права 0640 root:{{ deploy_user }}.
# Используются docker compose и сценарием выпуска cityduma-deploy (ЛР6).
APP_IMAGE={{ app_image }}
HTTP_PORT={{ http_port }}
PG_VOLUME={{ project_name }}_pg_data
LOG_LEVEL={{ log_level }}
LOG_FORMAT={{ log_format }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
APP_AUTH_USERS={{ app_admin_login }}:{{ app_admin_password }}:admin,{{ app_secretary_login }}:{{ app_secretary_password }}:secretary
SMOKE_USER={{ app_admin_login }}
SMOKE_PASSWORD={{ app_admin_password }}
AUTO_ROLLBACK={{ auto_rollback }}
